# Google Gemini API Key
# Obtain a free key from Google AI Studio: https://aistudio.google.com
GEMINI_API_KEY = "your-gemini-api-key-here"

# Optional: Preferred model (default: gemini-3.5-flash-lite)
# GEMINI_MODEL = "gemini-3.5-flash-lite"

# Gmail SMTP Credentials for emailing study notes
# 1. Enable 2-Step Verification on your Google Account: https://myaccount.google.com/security
# 2. Generate a 16-character App Password at: https://myaccount.google.com/apppasswords
# 3. Enter your Gmail address and the 16-character App Password below:
GMAIL_ADDRESS = "your-sending-email@gmail.com"
GMAIL_APP_PASSWORD = "xxxx xxxx xxxx xxxx"
